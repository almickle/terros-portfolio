# ── /tools gate ────────────────────────────────────────────
# Without TOOLS_PASSWORD the tools pages are LOCKED, not open — an unconfigured
# deployment must never serve internal pages to the public web.
TOOLS_PASSWORD=
# The cookie signing key. Falls back to TOOLS_PASSWORD if unset, which makes the
# signing key and the shared secret the same string — worth setting separately.
TOOLS_SECRET=

# ── Marketing manifest ─────────────────────────────────────
# Written by `bun run marketing/manifest.ts` in the menzi repo and uploaded by
# `bun run marketing/publish.ts`. Re-publishing updates the portal with no
# deploy here, which is the point of fetching it rather than importing it.
MARKETING_MANIFEST_URL=

# Only needed when MARKETING_MANIFEST_URL points at a LOCAL manifest, which
# carries no URLs by design. Serve marketing/out/web with any static server:
#   cd marketing/out/web && python3 -m http.server 8100
# MARKETING_MANIFEST_URL=../menzi/marketing/out/manifest.json
# MARKETING_ASSET_BASE=http://localhost:8100
MARKETING_ASSET_BASE=
