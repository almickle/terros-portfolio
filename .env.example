# ── /tools gate ────────────────────────────────────────────
# Without TOOLS_PASSWORD the tools pages are LOCKED, not open — an unconfigured
# deployment must never serve internal pages to the public web.
TOOLS_PASSWORD=
# The cookie signing key. Falls back to TOOLS_PASSWORD if unset, which makes the
# signing key and the shared secret the same string — worth setting separately.
TOOLS_SECRET=

# ── Marketing store ────────────────────────────────────────
# The SAME read-write token menzi's `bun run marketing/publish.ts` uploads with.
# The store is private, so the portal reads the manifest with this token and
# streams every image through /api/tools/asset behind the gate above. There is
# no URL to configure: the manifest path is a constant both sides hold.
BLOB_READ_WRITE_TOKEN=

# ── Local development only ─────────────────────────────────
# Runs the portal with no store at all, against the render output on disk:
#   cd ../menzi && bun run marketing/publish.ts --dry
#   cd marketing/out/web && python3 -m http.server 8100
# Leave both unset in production.
# MARKETING_MANIFEST_URL=/abs/path/to/menzi/marketing/out/manifest.json
# MARKETING_ASSET_BASE=http://localhost:8100
